{
  "info": {
    "name": "Vaultpost Auth API",
    "description": "Pruebas del servicio web de registro e inicio de sesión (GA7-220501096-AA5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Estado del servicio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salud"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Servicio activo\", () => pm.expect(pm.response.json().ok).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Registro exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"usuario\", \"juan.\" + Date.now().toString().slice(-8));",
              "pm.collectionVariables.set(\"contrasena\", \"Vaultpost2026\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Mensaje: registrado\", () => pm.expect(pm.response.json().mensaje).to.include(\"registrado\"));",
              "pm.test(\"Devuelve id del usuario\", () => pm.expect(pm.response.json().usuario.id).to.be.a(\"number\"));",
              "pm.test(\"No devuelve la contraseña\", () => pm.expect(pm.response.text()).to.not.include(\"Vaultpost2026\"));"
            ]
          }
        }
      ]
    },
    {
