              "pm.test(\"Mensaje: entre 4 y 30 caracteres\", () => pm.expect(pm.response.json().mensaje).to.include(\"entre 4 y 30 caracteres\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Inicio de sesión correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Mensaje: Autenticación satisfactoria\", () => pm.expect(pm.response.json().mensaje).to.include(\"Autenticación satisfactoria\"));",
              "const t = pm.response.json().token;",
              "pm.test(\"Entrega un token JWT\", () => pm.expect(t.split(\".\").length).to.eql(3));",
              "pm.collectionVariables.set(\"token\", t);"
            ]
          }
        }
      ]
    },
