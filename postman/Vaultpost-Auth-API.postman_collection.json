            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/perfil",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
